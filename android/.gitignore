# Everything in this folder belongs to the Android wrapper, not to the game. This file keeps only the sources
# (launcher page, Capacitor config, build scripts, the native project) under version control.

# --- build toolchain and output -------------------------------------------------------------------
# Android SDK + NDK + CMake + Gradle home/caches (~3.9 GB), recreated by scripts/setup-sdk.ps1
.build/
# the finished APK(s), written by scripts/build-apk.ps1
dist/

# --- generated by scripts/assemble-nodejs.mjs -----------------------------------------------------
# The staged Node.js project (server + shared + data + the whole ~330 MB public/ client) and the
# Capacitor browser bundles copied out of node_modules. Both are rebuilt from the game repository.
web/nodejs/
web/vendor/

# --- dependencies ---------------------------------------------------------------------------------
node_modules/

# --- Gradle / Capacitor build output (the native android/ project itself IS committed) -------------
android/build/
android/app/build/
android/.gradle/
android/.cxx/
android/local.properties
# written by `cap sync`
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/app/src/main/res/xml/config.xml
android/capacitor-cordova-android-plugins/

# --- self-signed release key generated by scripts/build-apk.ps1 ------------------------------------
# A throwaway key for side-loading. Regenerate it on a fresh machine by deleting both files.
android/stronghold-release.jks
android/keystore.properties
